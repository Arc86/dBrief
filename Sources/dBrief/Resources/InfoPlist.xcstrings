        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief a besoin d’accéder à votre micro pour enregistrer votre voix pendant les appels et les enregistrements vocaux."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief heeft toegang tot je microfoon nodig om je stem op te nemen tijdens gesprekken en spraakopnamen."
          }
        }
      }
    },
