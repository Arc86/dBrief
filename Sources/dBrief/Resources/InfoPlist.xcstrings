{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Permission prompt shown by macOS. Keep in step with Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief steuert Notizen, um deine Meeting-Notizen zu sichern, wenn die Apple Notes-Integration aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dBrief controls Notes to save your meeting notes when the Apple Notes integration is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief controla Notas para guardar tus notas de reuniones cuando la integración con Apple Notes está activada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief contrôle Notes pour enregistrer vos notes de réunion lorsque l’intégration Apple Notes est activée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief bestuurt Notities om je vergaderaantekeningen te bewaren wanneer de Apple Notes-integratie aan staat."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Permission prompt shown by macOS. Keep in step with Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief nutzt deinen Kalender, um beim Aufnehmen Titel, Teilnehmer und Agenda des Meetings vorauszufüllen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dBrief accesses your calendar to pre-fill meeting title, participants, and agenda context at recording time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief accede a tu calendario para rellenar el título, los participantes y la agenda de la reunión al grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief accède à votre calendrier pour préremplir le titre, les participants et l’ordre du jour de la réunion pendant l’enregistrement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief gebruikt je agenda om de titel, deelnemers en agenda van een vergadering in te vullen wanneer je opneemt."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt shown by macOS. Keep in step with Info.plist.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief benötigt Zugriff auf dein Mikrofon, um bei Anrufen und Sprachaufnahmen deine Stimme aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dBrief needs microphone access to record audio from your microphone during calls and voice recordings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "dBrief necesita acceder a tu micrófono para grabar tu voz durante llamadas y grabaciones de voz."
