    "Parakeet detects language automatically. v2 supports English; v3 supports 25 European languages. The spoken language selection does not force Parakeet decoding." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parakeet erkennt die Sprache automatisch. v2 unterstützt Englisch, v3 25 europäische Sprachen. Die gewählte gesprochene Sprache erzwingt keine bestimmte Dekodierung durch Parakeet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parakeet detecta el idioma automáticamente. v2 admite inglés; v3 admite 25 idiomas europeos. El idioma hablado seleccionado no fuerza la decodificación de Parakeet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parakeet détecte la langue automatiquement. v2 prend en charge l’anglais ; v3 prend en charge 25 langues européennes. La langue parlée choisie n’impose pas le décodage de Parakeet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parakeet herkent de taal automatisch. v2 ondersteunt Engels; v3 ondersteunt 25 Europese talen. De gekozen gesproken taal dwingt het decoderen door Parakeet niet af."
          }
        }
      }
    },
