    "Replaces `claude` in the managed command, e.g. `cswap run 1 --` for another account. Ignored when a CLI command is set." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ersetzt `claude` im verwalteten Befehl, z. B. `cswap run 1 --` für einen anderen Account. Wird ignoriert, wenn ein CLI-Befehl festgelegt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sustituye `claude` en el comando gestionado, p. ej., `cswap run 1 --` para otra cuenta. Se ignora si hay un comando CLI definido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remplace `claude` dans la commande gérée, par exemple `cswap run 1 --` pour un autre compte. Ignoré si une commande CLI est définie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vervangt `claude` in het beheerde commando, bijv. `cswap run 1 --` voor een ander account. Wordt genegeerd als er een CLI-commando is ingesteld."
          }
        }
      }
    },
    "Replaces the draft. Save when you’re ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
