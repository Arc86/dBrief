    "This permanently deletes matching files in %@. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dadurch werden passende Dateien in %@ endgültig gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se eliminarán de forma permanente los archivos coincidentes de %@. Esta acción no se puede deshacer."
          }
