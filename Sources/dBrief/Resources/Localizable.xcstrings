    "Some attempts or outcomes are missing. This history cannot establish all processing that occurred." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einige Versuche oder Ergebnisse fehlen. Dieser Verlauf kann nicht die gesamte erfolgte Verarbeitung belegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faltan algunos intentos o resultados. Este historial no puede reflejar todo el procesamiento que se realizó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Certaines tentatives ou certains résultats sont manquants. Cet historique ne peut pas établir tout le traitement effectué."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sommige pogingen of resultaten ontbreken. Deze geschiedenis kan niet alle verwerking vaststellen die heeft plaatsgevonden."
          }
        }
      }
    },
    "Some deliveries still need attention. Use Integrations… to review them." : {
      "localizations" : {
        "de" : {
