    "Access blocked — check the Claude login and connector permission, then retest." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toegang geblokkeerd — controleer de Claude-login en connectortoestemming en test opnieuw."
          }
        }
      }
    },
    "Account name" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
