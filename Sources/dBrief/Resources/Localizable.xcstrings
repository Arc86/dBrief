          }
        }
      }
    },
    "The transcript is larger than the model's context window. Increase your server's context size (e.g. llama.cpp --ctx-size / vLLM --max-model-len) or use an endpoint with a larger context." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Transkript ist größer als das Kontextfenster des Modells. Erhöhe die Kontextgröße deines Servers (z. B. llama.cpp --ctx-size / vLLM --max-model-len) oder verwende einen Endpunkt mit größerem Kontext."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La transcripción es más grande que la ventana de contexto del modelo. Aumenta el tamaño de contexto de tu servidor (p. ej., llama.cpp --ctx-size / vLLM --max-model-len) o usa un endpoint con más contexto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
