    "Current results stay readable while processing; editing is temporarily paused. Successful results replace the current set, with one previous set available to restore. Changes apply only to this attempt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die aktuellen Ergebnisse bleiben während der Verarbeitung lesbar; Bearbeiten ist vorübergehend pausiert. Erfolgreiche Ergebnisse ersetzen die aktuellen, und ein vorheriger Stand bleibt zum Wiederherstellen verfügbar. Änderungen gelten nur für diesen Versuch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los resultados actuales se pueden leer durante el procesamiento; la edición se pausa temporalmente. Los resultados correctos sustituyen al conjunto actual, y se puede restaurar un conjunto anterior. Los cambios solo se aplican a este intento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les résultats actuels restent consultables pendant le traitement ; la modification est temporairement suspendue. Les résultats obtenus remplacent l’ensemble actuel, et l’ensemble précédent reste disponible pour être restauré. Les modifications ne s’appliquent qu’à cette tentative."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Huidige resultaten blijven leesbaar tijdens de verwerking; wijzigen is tijdelijk gepauzeerd. Geslaagde resultaten vervangen de huidige set, en één vorige set blijft beschikbaar om te herstellen. Wijzigingen gelden alleen voor deze poging."
          }
        }
      }
    },
