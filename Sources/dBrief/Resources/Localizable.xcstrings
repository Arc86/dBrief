    "Removes all per-model benchmark history. The total minutes transcribed is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt den gesamten Benchmark-Verlauf pro Modell. Die Gesamtzahl der transkribierten Minuten bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina todo el historial de pruebas de rendimiento por modelo. Se conserva el total de minutos transcritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime tout l’historique des tests de performance par modèle. Le total des minutes transcrites est conservé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijdert alle benchmarkgeschiedenis per model. Het totaal aantal getranscribeerde minuten blijft bewaard."
          }
        }
      }
    },
    "Removes meeting audio your microphone picks up from the speakers. Skipped automatically with headphones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt Meeting-Audio, das dein Mikrofon von den Lautsprechern aufnimmt. Wird bei Kopfhörern automatisch übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina el audio de la reunión que tu micrófono capta de los altavoces. Se omite automáticamente con auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime l’audio de la réunion que votre micro capte depuis les haut-parleurs. Ignoré automatiquement avec un casque."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijdert vergaderaudio die je microfoon uit de luidsprekers opvangt. Wordt automatisch overgeslagen met een koptelefoon."
          }
        }
      }
    },
    "Removes whole lines such as “Thanks for watching”. Real speech that contains a phrase is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt ganze Zeilen wie „Danke fürs Zuschauen“. Echte Sprache, die eine solche Phrase enthält, bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina líneas enteras como “Gracias por ver el vídeo”. Se conserva el habla real que contenga una frase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime des lignes entières comme « Merci d’avoir regardé ». Les vraies paroles qui contiennent une expression sont conservées."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwijdert hele regels zoals “Bedankt voor het kijken”. Echte spraak die een zin bevat, blijft bewaard."
          }
        }
      }
    },
