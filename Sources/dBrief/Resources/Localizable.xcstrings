      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "KI-Ergebnisse konnten nicht erstellt werden.\n\n%@\n\nDie aktuellen Ergebnisse wurden beibehalten. Behebe den Fehler und wähle dann unter „Warteschlange & Wiederherstellung“ die Option „Fortsetzen“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudieron generar los resultados de IA.\n\n%@\n\nSe conservaron los resultados actuales. Resuelve el error y elige Reanudar en Cola y recuperación para volver a intentarlo."
