    "You are responsible for how you use dBrief, including informing participants, obtaining any required consent, and following applicable laws and your organisation’s policies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du bist dafür verantwortlich, wie du dBrief verwendest, einschließlich der Information der Teilnehmer, der Einholung erforderlicher Einwilligungen und der Einhaltung geltender Gesetze und der Richtlinien deiner Organisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eres responsable de cómo usas dBrief, lo que incluye informar a los participantes, obtener el consentimiento necesario y cumplir las leyes aplicables y las políticas de tu organización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous êtes responsable de votre utilisation de dBrief, notamment d’informer les participants, d’obtenir tout consentement requis et de respecter la législation applicable et les règles de votre organisation."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je bent zelf verantwoordelijk voor hoe je dBrief gebruikt, waaronder het informeren van deelnemers, het verkrijgen van eventueel vereiste toestemming en het naleven van toepasselijke wetgeving en het beleid van je organisatie."
          }
        }
      }
    },
