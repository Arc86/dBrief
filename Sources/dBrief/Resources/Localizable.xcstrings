    "%@ requires %.1f GB but only %.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps if it stalls." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires %2$.1f GB but only %3$.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps if it stalls."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ heeft %.1f GB nodig, maar er is maar %.1f GB beschikbaar. De verwerking wordt toch geprobeerd, maar kan traag zijn of mislukken bij geheugendruk. Sluit andere apps als het vastloopt."
          }
        }
      }
    },
    "%@ requires %.1f GB but only %.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps or retry with a remote endpoint if it stalls." : {
