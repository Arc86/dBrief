        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La réponse de l’IA a dépassé la longueur maximale. Demandez une révision plus courte et réessayez."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het AI-antwoord overschreed de lengtelimiet. Vraag om een kortere herziening en probeer het opnieuw."
