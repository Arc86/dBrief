    "Hides this run. The recording and its current results stay; the unfinished run can't be resumed afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blendet diesen Vorgang aus. Die Aufnahme und ihre aktuellen Ergebnisse bleiben erhalten; der unvollständige Vorgang kann danach nicht fortgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oculta este procesamiento. La grabación y sus resultados actuales se mantienen; el procesamiento sin terminar no se podrá reanudar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Masque ce traitement. L’enregistrement et ses résultats actuels sont conservés ; le traitement inachevé ne pourra plus être repris."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbergt deze verwerking. De opname en de huidige resultaten blijven behouden; de onvoltooide verwerking kan daarna niet worden hervat."
          }
        }
      }
