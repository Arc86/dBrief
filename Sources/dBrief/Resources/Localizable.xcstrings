    "The AI did not return a complete, valid prompt suggestion. Try again or adjust your request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die KI hat keinen vollständigen, gültigen Prompt-Vorschlag geliefert. Versuche es erneut oder passe deine Anfrage an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La IA no devolvió una sugerencia de prompt completa y válida. Inténtalo de nuevo o ajusta tu solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’IA n’a pas renvoyé de suggestion de prompt complète et valide. Réessayez ou modifiez votre demande."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De AI gaf geen volledige, geldige promptsuggestie. Probeer het opnieuw of pas je verzoek aan."
          }
        }
      }
    },
    "The AI response exceeded the length limit. Ask for a shorter revision and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
