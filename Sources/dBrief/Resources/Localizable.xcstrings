    "Pause prevents the next job from starting; the current job can finish. This setting survives a restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Pausieren“ verhindert den Start des nächsten Auftrags; der aktuelle Auftrag kann zu Ende laufen. Diese Einstellung bleibt nach einem Neustart erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pausar impide que empiece el siguiente trabajo; el actual puede terminar. Este ajuste se mantiene tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La suspension empêche la tâche suivante de démarrer ; la tâche en cours peut se terminer. Ce réglage est conservé après un redémarrage."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pauzeren voorkomt dat de volgende taak start; de huidige taak kan afronden. Deze instelling blijft behouden na een herstart."
          }
        }
      }
    },
