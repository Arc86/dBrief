    "Smaller models are faster but less accurate. Larger models are more accurate but use more memory and time. Ratings are estimates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kleinere Modelle sind schneller, aber ungenauer. Größere Modelle sind genauer, brauchen aber mehr Speicher und Zeit. Bewertungen sind Schätzungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los modelos más pequeños son más rápidos pero menos precisos. Los más grandes son más precisos pero usan más memoria y tiempo. Las valoraciones son estimaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les petits modèles sont plus rapides mais moins précis. Les grands modèles sont plus précis mais utilisent plus de mémoire et de temps. Les notes sont des estimations."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kleinere modellen zijn sneller maar minder nauwkeurig. Grotere modellen zijn nauwkeuriger maar gebruiken meer geheugen en tijd. Beoordelingen zijn schattingen."
          }
        }
      }
    },
