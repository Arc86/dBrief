    "Start also discards this recording's unfinished run in Queue & Recovery. Its saved progress can't be resumed afterwards." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Starten“ verwirft außerdem den unvollständigen Vorgang dieser Aufnahme unter „Warteschlange & Wiederherstellung“. Der gesicherte Fortschritt kann danach nicht mehr fortgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iniciar también descarta el procesamiento sin terminar de esta grabación en Cola y recuperación. Su progreso guardado no se podrá reanudar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Démarrer supprime aussi le traitement inachevé de cet enregistrement dans File d’attente et récupération. Sa progression enregistrée ne pourra plus être reprise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start verwijdert ook de onvoltooide verwerking van deze opname in Wachtrij en herstel. De bewaarde voortgang kan daarna niet worden hervat."
          }
        }
      }
    },
