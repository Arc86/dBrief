    "%@ requires %.1f GB but only %.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps if it stalls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ benötigt %.1f GB, aber nur %.1f GB sind verfügbar. Die Verarbeitung wird trotzdem versucht, kann bei Speicherknappheit aber langsam laufen oder fehlschlagen. Schließe andere Apps, falls sie hängen bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires %2$.1f GB but only %3$.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps if it stalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ requiere %.1f GB, pero solo hay %.1f GB disponibles. Se intentará procesar igualmente, pero puede ir lento o fallar por falta de memoria. Cierra otras apps si se detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ nécessite %2$.1f Go, mais seuls %3$.1f Go sont disponibles. Le traitement sera tout de même tenté, mais il peut être lent ou échouer si la mémoire est saturée. Fermez d’autres apps s’il se bloque."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ heeft %.1f GB nodig, maar er is maar %.1f GB beschikbaar. De verwerking wordt toch geprobeerd, maar kan traag zijn of mislukken bij geheugendruk. Sluit andere apps als het vastloopt."
          }
        }
      }
    },
    "%@ requires %.1f GB but only %.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps or retry with a remote endpoint if it stalls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ benötigt %.1f GB, aber nur %.1f GB sind verfügbar. Die Verarbeitung wird trotzdem versucht, kann bei Speicherknappheit aber langsam laufen oder fehlschlagen. Schließe andere Apps oder versuche es mit einem externen Endpunkt erneut, falls sie hängen bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires %2$.1f GB but only %3$.1f GB is available. Processing will still be attempted, but it may run slowly or fail under memory pressure. Close other apps or retry with a remote endpoint if it stalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ requiere %.1f GB, pero solo hay %.1f GB disponibles. Se intentará procesar igualmente, pero puede ir lento o fallar por falta de memoria. Cierra otras apps o vuelve a intentarlo con un endpoint remoto si se detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ nécessite %2$.1f Go, mais seuls %3$.1f Go sont disponibles. Le traitement sera tout de même tenté, mais il peut être lent ou échouer si la mémoire est saturée. Fermez d’autres apps ou réessayez avec un point de terminaison distant s’il se bloque."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ heeft %.1f GB nodig, maar er is maar %.1f GB beschikbaar. De verwerking wordt toch geprobeerd, maar kan traag zijn of mislukken bij geheugendruk. Sluit andere apps of probeer het opnieuw met een extern endpoint als het vastloopt."
          }
        }
      }
    },
    "%@ requires an audio file %@. Compress this recording or choose another endpoint, then retry. The original audio has been kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ erfordert eine Audiodatei %@. Komprimiere diese Aufnahme oder wähle einen anderen Endpunkt und versuche es dann erneut. Das Original-Audio wurde beibehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires an audio file %2$@. Compress this recording or choose another endpoint, then retry. The original audio has been kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ requiere un archivo de audio de %2$@. Comprime esta grabación o elige otro endpoint y vuelve a intentarlo. Se ha conservado el audio original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ exige un fichier audio de %2$@. Compressez cet enregistrement ou choisissez un autre point de terminaison, puis réessayez. L’audio d’origine a été conservé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ vereist een audiobestand dat %@ is. Comprimeer deze opname of kies een ander endpoint en probeer het opnieuw. De originele audio is bewaard."
          }
        }
      }
    },
